# ---- AI provider ---------------------------------------------------------
# ollama = local, no API key (default) 
AI_PROVIDER=ollama

# Ollama exposes an OpenAI-compatible API at /v1 (no key). Pull models first,
# using the exact tags from `ollama list`:
#   ollama pull nomic-embed-text      # embeddings, 768-dim
#   ollama pull qwen2.5:7b-instruct   # answers, ~4.7 GB
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=qwen2.5:7b-instruct

# Used only when AI_PROVIDER=openai( I haven't test this flow).
# OPENAI_API_KEY=
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_CHAT_MODEL=gpt-4o-mini

# ---- Retrieval / chunking ------------------------------------------------
# Chunk size and overlap are in characters; TOP_K is chunks retrieved per query.
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=4
# Cosine floor: chunks scoring below this count as irrelevant.
MIN_RELEVANCE_SCORE=0.05
# LLM yes/no check that the context answers the question.
RELEVANCE_GATE=false

# ---- Storage -------------------------------------------------------------
# SQLite file; the durable source of truth (the vector index rebuilds from it).
DATABASE_PATH=knowledge_inbox.db

# ---- Server --------------------------------------------------------------
LOG_LEVEL=INFO
# Comma-separated frontend origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
