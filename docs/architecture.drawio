        <mxCell id="q_embed" value="Embed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;" vertex="1" parent="1"><mxGeometry x="152" y="288" width="96" height="34" as="geometry"/></mxCell>
